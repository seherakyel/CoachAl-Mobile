# Şablon: kopyalayıp `.env` veya Android için `.env.local` oluşturun.
#
# Android debug: `android/app/build.gradle` içinde debug → repo kökündeki `.env.local` kullanılır.
# Örnek `.env.local`:
#   API_BASE_URL=http://10.0.0.2:8000
#
# iOS / release: `ENVFILE=.env.local npx react-native run-ios` veya kökte `.env` kullanın.
#
API_BASE_URL=
API_BASE_URL_PRODUCTION=
