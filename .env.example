# Sunum / acil: yerel ağ takılıyorsa canlı API kökünü yazın (Android yeniden build gerekir). Örnek: https://api.ornek.com
# Boş bırakın: geliştirmede http://127.0.0.1:8000; emülatör için önce cihazı açıp `npm run present:android` veya `npm run adb:reverse`
# Alternatif (reverse kullanmadan): API_BASE_URL=http://10.0.2.2:8000
# Gerçek telefon: API_BASE_URL=http://BILGISAYAR_LAN_IP:8000
# Kök adres; sonda /api yazmayın (kod ekler).
API_BASE_URL_PRODUCTION=
